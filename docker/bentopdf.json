{
  "name": "BentoPDF",
  "repo": "ghcr.io/alam00000/bentopdf-simple:latest",
  "category": ["utilities"],
  "registry": "https://github.com/alam00000/bentopdf/pkgs/container/bentopdf-simple",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart unless-stopped",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:8080]/",
  "icon": "https://raw.githubusercontent.com/alam00000/bentopdf/refs/heads/main/public/images/favicon.svg",
  "project": "https://www.bentopdf.com/",
  "support": "https://github.com/alam00000/bentopdf/issues",
  "description": "BentoPDF is a privacy-first PDF toolkit (merge, split, compress, convert, edit, sign) that runs entirely client-side in the browser. This is the self-hosted build; no files are stored or persisted by the container.",
  "donate": null,
  "requires": null,
  "paths": [],
  "ports": [
    {
      "name": "WebUI",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "BentoPDF web interface.",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "Disable IPv6",
      "key": "DISABLE_IPV6",
      "value": "false",
      "description": "Set to true in IPv4-only environments.",
      "required": false,
      "mask": false
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}
