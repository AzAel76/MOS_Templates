# Full list of supported variables: https://docs.romm.app/latest/Getting-Started/Environment-Variables/

# App publish port on the host.
APP_PORT=80

# Host folders for your library, uploaded assets, and (optional) config.yml.
# Use absolute paths on NAS/Portainer installs.
LIBRARY_HOST_PATH=./library
ASSETS_HOST_PATH=./assets
CONFIG_HOST_PATH=./config

# Database name/user shared between the app and the bundled MariaDB container.
DB_NAME=romm
DB_USER=romm-user

# Database credentials. Change these before deploying.
DB_PASSWD=change-this-password
DB_ROOT_PASSWD=change-this-root-password

# App secret. Generate with: openssl rand -hex 32
ROMM_AUTH_SECRET_KEY=change-this-to-a-long-random-secret

# Recommended metadata providers (all optional, but improve scraping accuracy).
# https://docs.romm.app/latest/Getting-Started/Metadata-Providers/
SCREENSCRAPER_USER=
SCREENSCRAPER_PASSWORD=
RETROACHIEVEMENTS_API_KEY=
STEAMGRIDDB_API_KEY=
HASHEOUS_API_ENABLED=true

# Scan/worker tuning. Raise SCAN_WORKERS for faster scans on more capable hardware,
# and WEB_SERVER_CONCURRENCY for more concurrent users.
SCAN_WORKERS=4
WEB_SERVER_CONCURRENCY=4
